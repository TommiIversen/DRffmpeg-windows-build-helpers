diff --git a/fftools/ffmpeg.c b/fftools/ffmpeg.c
index b394243f59..9b647c7800 100644
--- a/fftools/ffmpeg.c
+++ b/fftools/ffmpeg.c
@@ -86,9 +86,50 @@
 #include "ffmpeg_utils.h"
 #include "graph/graphprint.h"
 
-const char program_name[] = "ffmpeg";
+const char program_name[] = "ffmpeg 2mmilab " __DATE__ " " __TIME__;
 const int program_birth_year = 2000;
 
+static uint64_t total_size_bytes = 0;
+int slow = 0;
+int slow_target = 0;
+static int slow_armed = 0;
+
+static const int slow_delays[] = {
+    0,       /* 0: full speed   */
+    2500,    /* 1: 2.5ms        */
+    5000,    /* 2: 5ms          */
+    10000,   /* 3: 10ms         */
+    25000,   /* 4: 25ms         */
+    50000,   /* 5: 50ms         */
+    100000,  /* 6: 100ms        */
+    200000,  /* 7: 200ms        */
+    400000,  /* 8: 400ms        */
+    700000,  /* 9: 700ms        */
+};
+
+int get_slow_delay(void)
+{
+    static int env_checked = 0;
+    if (!env_checked) {
+        const char *env = getenv("FFMPEG_SLOW");
+        if (env) {
+            int level = atoi(env);
+            if (level >= 0 && level <= 9)
+                slow_target = level;
+        }
+        env_checked = 1;
+    }
+    if (slow >= 0 && slow <= 9)
+        return slow_delays[slow];
+    return 0;
+}
+
+void ff_set_input_cursor(int64_t pos)
+{
+    if (pos > 0)
+        total_size_bytes = pos;
+}
+
 FILE *vstats_file;
 
 typedef struct BenchmarkTimeStamps {
@@ -694,6 +735,16 @@ static void print_report(int is_last_report, int64_t timer_start, int64_t cur_ti
         av_bprintf(&buf_script, "speed=%4.3gx\n", speed);
     }
 
+    /* activate slow after first progress report (startup phase is over) */
+    if (!slow_armed && slow_target > 0) {
+        slow = slow_target;
+        slow_armed = 1;
+        av_log(NULL, AV_LOG_INFO, "\nslow level activated: %d (delay: %d us)\n", slow, get_slow_delay());
+    }
+
+    av_bprintf(&buf, " cursor=%" PRId64, total_size_bytes);
+    av_bprintf(&buf, " slow=%d", slow);
+
     secs = (int)t;
     ms = (int)((t - secs) * 1000);
     mins = secs / 60;
@@ -878,6 +929,13 @@ static int check_keyboard_interaction(int64_t cur_time)
                         "s      Show QP histogram\n"
         );
     }
+
+    /* slow level 0-9 */
+    if (key >= '0' && key <= '9') {
+        slow = key - '0';
+        av_log(NULL, AV_LOG_INFO, "\nslow level set to %d (delay: %d us)\n", slow, get_slow_delay());
+    }
+
     return 0;
 }
 
