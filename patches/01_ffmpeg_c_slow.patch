diff --git a/fftools/ffmpeg.c b/fftools/ffmpeg.c
index b394243f59..0000000001 100644
--- a/fftools/ffmpeg.c
+++ b/fftools/ffmpeg.c
@@ -86,9 +86,50 @@
 #include "ffmpeg_utils.h"
 #include "graph/graphprint.h"
 
-const char program_name[] = "ffmpeg";
+const char program_name[] = "ffmpeg 2mmilab " __DATE__ " " __TIME__;
 const int program_birth_year = 2000;
 
+static uint64_t total_size_bytes = 0;
+int slow = 0;
+
+static const int slow_delays[] = {
+    0,       /* 0: full speed   */
+    10000,   /* 1: 10ms         */
+    25000,   /* 2: 25ms         */
+    50000,   /* 3: 50ms         */
+    100000,  /* 4: 100ms        */
+    200000,  /* 5: 200ms        */
+    400000,  /* 6: 400ms        */
+    700000,  /* 7: 700ms        */
+    1000000, /* 8: 1s           */
+    2000000  /* 9: 2s           */
+};
+
+int get_slow_delay(void)
+{
+    static int env_checked = 0;
+    if (!env_checked) {
+        const char *env = getenv("FFMPEG_SLOW");
+        if (env) {
+            int level = atoi(env);
+            if (level >= 0 && level <= 9)
+                slow = level;
+        }
+        env_checked = 1;
+    }
+    if (slow >= 0 && slow <= 9)
+        return slow_delays[slow];
+    return 0;
+}
+
+void ff_add_input_bytes(int size)
+{
+    if (size > 0)
+    {
+        total_size_bytes += size;
+    }
+}
+
 FILE *vstats_file;
 
