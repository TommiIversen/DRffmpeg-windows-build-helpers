diff --git a/fftools/ffmpeg.c b/fftools/ffmpeg.c
index b394243f59..9b647c7800 100644
--- a/fftools/ffmpeg.c
+++ b/fftools/ffmpeg.c
@@ -86,9 +86,48 @@
 #include "ffmpeg_utils.h"
 #include "graph/graphprint.h"
 
-const char program_name[] = "ffmpeg";
+const char program_name[] = "ffmpeg 2mmilab " __DATE__ " " __TIME__;
 const int program_birth_year = 2000;
 
+static uint64_t total_size_bytes = 0;
+int slow = 0;
+
+static const int slow_delays[] = {
+    0,       /* 0: full speed   */
+    5000,    /* 1: 5ms          */
+    10000,   /* 2: 10ms         */
+    25000,   /* 3: 25ms         */
+    50000,   /* 4: 50ms         */
+    100000,  /* 5: 100ms        */
+    200000,  /* 6: 200ms        */
+    400000,  /* 7: 400ms        */
+    700000,  /* 8: 700ms        */
+    1000000  /* 9: 1s           */
+};
+
+int get_slow_delay(void)
+{
+    static int env_checked = 0;
+    if (!env_checked) {
+        const char *env = getenv("FFMPEG_SLOW");
+        if (env) {
+            int level = atoi(env);
+            if (level >= 0 && level <= 9)
+                slow = level;
+        }
+        env_checked = 1;
+    }
+    if (slow >= 0 && slow <= 9)
+        return slow_delays[slow];
+    return 0;
+}
+
+void ff_set_input_cursor(int64_t pos)
+{
+    if (pos > 0)
+        total_size_bytes = pos;
+}
+
 FILE *vstats_file;
 
 typedef struct BenchmarkTimeStamps {
@@ -694,6 +733,9 @@ static void print_report(int is_last_report, int64_t timer_start, int64_t cur_ti
         av_bprintf(&buf_script, "speed=%4.3gx\n", speed);
     }
 
+    av_bprintf(&buf, " cursor=%" PRId64, total_size_bytes);
+    av_bprintf(&buf, " slow=%d", slow);
+
     secs = (int)t;
     ms = (int)((t - secs) * 1000);
     mins = secs / 60;
@@ -878,6 +920,13 @@ static int check_keyboard_interaction(int64_t cur_time)
                         "s      Show QP histogram\n"
         );
     }
+
+    /* slow level 0-9 */
+    if (key >= '0' && key <= '9') {
+        slow = key - '0';
+        av_log(NULL, AV_LOG_INFO, "\nslow level set to %d (delay: %d us)\n", slow, get_slow_delay());
+    }
+
     return 0;
 }
 
