diff --git a/fftools/ffmpeg_demux.c b/fftools/ffmpeg_demux.c
index c317987841..53c510107a 100644
--- a/fftools/ffmpeg_demux.c
+++ b/fftools/ffmpeg_demux.c
@@ -471,6 +471,15 @@ static int input_packet_process(Demuxer *d, AVPacket *pkt, unsigned *send_flags)
     FrameData *fd;
     int ret = 0;
 
+
+    /* slow down: level 1-9, 0 = full speed */
+    if (slow > 0) {
+        av_usleep(get_slow_delay());
+    }
+
+    /* track actual file read position for growing-file cursor */
+    if (d->f.ctx->pb)
+        ff_set_input_cursor(avio_tell(d->f.ctx->pb));
     fd = packet_data(pkt);
     if (!fd)
         return AVERROR(ENOMEM);
